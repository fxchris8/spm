# Keep backup directory structure
!backups/.gitkeep

# ===== IDE =====
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ===== DATA FILES (may contain sensitive info) =====
# Keep example/template files, ignore actual data
data/*.csv
data/*.json
data/*.xlsx
data/reports/*.csv
data/reports/*.txt

# Keep template/example files
!data/*example*
!data/*template*
!data/.gitkeep

# ===== SENSITIVE FILES =====
# Environment files - NEVER commit these
.env
.env.*
!.env.example
!.env.docker

# Credentials and keys
*.pem
*.key
*.cert
*.crt
secrets/
credentials/

