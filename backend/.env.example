JWT_SECRET_KEY=<YOUR_SECRET_KEY>

DB_HOST=localhost
DB_PORT=<YOUR_PORT>
DB_USER=postgres
DB_PASSWORD=<YOUR_DB_PASSWORD>
DB_NAME=<YOUR_DATABASE_NAME>

POSTGRES_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/postgres
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

SMTP_SERVER-=<YOUR_SMTP_SERVER>
SMTP_PORT=<YOUR_SMTP_PORT>
EMAIL_SENDER=<YOUR_SENDER_EMAIL>
EMAIL_PASSWORD=<YOUR_EMAIL_APP_PASSWORD>
EMAIL_RECIPIENTS=<YOUR_RECIPIENT_EMAIL>

API_BASE_URL_PUSAT=<YOUR_API_BASE_URL_PUSAT>
API_BASE_URL_IT=<YOUR_API_BASE_URL_IT>

FLASK_ENV=production
FLASK_DEBUG=0

SSO_BASE_URL=http://host.docker.internal:5000
SSO_FRONTEND_URL=http://localhost:5173
SSO_CLIENT_ID=<YOUR_SSO_CLIENT_ID>
SSO_CLIENT_SECRET=<YOUR_SSO_CLIENT_SECRET>
SSO_CALLBACK_URL=http://localhost:5000/api/auth/sso/callback
FRONTEND_URL=http://localhost:5173
